# A host behind a TLS tunnel or Nginx Proxy Manager: loopback publish, https overwrite and
# the proxy's address trusted so the real client IP survives.
HOST_BIND=127.0.0.1
HOST_PORT=18080
HOST_HTML_DIR=%h/.local/share/nextcloud/html
HOST_DATA_DIR=/srv/nextcloud-data
HOST_POSTGRES_DIR=%h/.local/share/nextcloud/postgres
HOST_REDIS_DIR=%h/.local/share/nextcloud/redis
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_TRUSTED_DOMAINS=cloud.example.com
OVERWRITEPROTOCOL=https
OVERWRITECLIURL=https://cloud.example.com
TRUSTED_PROXIES=10.89.0.1
PHP_MEMORY_LIMIT=1G
PHP_UPLOAD_LIMIT=16G
