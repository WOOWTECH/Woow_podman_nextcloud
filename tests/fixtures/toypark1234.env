# What scripts/migrate-legacy.sh writes on toypark1234: the four directories stay where the
# manual deployment put them (they move to ~/.local/share/nextcloud after the soak period),
# and the publish keeps 0.0.0.0:18080 because the two users reach it over the LAN and the
# tailnet, not through a proxy.
HOST_BIND=0.0.0.0
HOST_PORT=18080
HOST_HTML_DIR=%h/podman/nextcloud/data/nextcloud/html
HOST_DATA_DIR=%h/podman/nextcloud/data/nextcloud/data
HOST_POSTGRES_DIR=%h/podman/nextcloud/data/postgres
HOST_REDIS_DIR=%h/podman/nextcloud/data/redis
NEXTCLOUD_ADMIN_USER=toypark1234
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1 192.168.1.146 100.112.215.78
OVERWRITEPROTOCOL=http
OVERWRITECLIURL=http://192.168.1.146:18080
TRUSTED_PROXIES=
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=512M
