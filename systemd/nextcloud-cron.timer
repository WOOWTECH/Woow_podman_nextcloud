# nextcloud-cron.timer: every 5 minutes, like the image's crontab (*/5).
# OnCalendar (wall clock) rather than OnUnitActiveSec: a run that ExecCondition skips does
# not re-arm an OnUnitActiveSec timer, which would stop background jobs for good.
[Unit]
Description=Run Nextcloud cron.php every 5 minutes
Documentation=https://github.com/WOOWTECH/Woow_podman_nextcloud

[Timer]
OnCalendar=*:0/5
AccuracySec=10s
Unit=nextcloud-cron.service

[Install]
WantedBy=timers.target
