# ~/.config/nextcloud/nextcloud.env: the per-host settings of this Nextcloud install
# (mode 0600). scripts/install.sh creates it from config/nextcloud.env.example and reads it
# on every run. Format: KEY=value lines only. No quotes, no "export", no "# comment" after
# a value. A value may contain spaces (NEXTCLOUD_TRUSTED_DOMAINS).
#
# Two kinds of keys live here:
#   HOST_*   rendered into the unit files by scripts/install.sh (run it again after a change)
#   the rest passed to the app container with --env-file (the image reads them)
# NEVER add a key that starts with NC_ : Nextcloud reads NC_<key> as an override of
# config.php. Passwords are podman secrets: nextcloud-db-password, nextcloud-admin-password.

# ---- Host side (rendered into the units) ---------------------------------------------
# Publish address. 127.0.0.1 when a tunnel or NPM on this host is the way in; 0.0.0.0 for
# direct LAN or tailnet access.
HOST_BIND=127.0.0.1
HOST_PORT=18080

# Nextcloud's code and configuration (/var/www/html, includes config/config.php).
HOST_HTML_DIR=%h/.local/share/nextcloud/html
# The user files (/var/www/html/data). This is the one that grows.
HOST_DATA_DIR=%h/.local/share/nextcloud/data
# PostgreSQL. LOCAL DISK ONLY: a Postgres cluster on NFS or SMB will be corrupted.
HOST_POSTGRES_DIR=%h/.local/share/nextcloud/postgres
# Redis append-only file.
HOST_REDIS_DIR=%h/.local/share/nextcloud/redis

# ---- First install only (the image ignores these once installed) ---------------------
NEXTCLOUD_ADMIN_USER=admin
# Space-separated. The image writes them to trusted_domains when it starts; without the
# name or address you use in the browser, Nextcloud answers "untrusted domain".
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1

# ---- Every request (the image's reverse-proxy.config.php reads these) ----------------
# Set OVERWRITEPROTOCOL=https when users arrive through a TLS proxy or tunnel that does not
# send X-Forwarded-Proto, otherwise leave it empty. TRUSTED_PROXIES (space-separated) makes
# Nextcloud trust the forwarded headers of your proxy, which also restores the real client
# IP in the log and in brute-force protection.
OVERWRITEPROTOCOL=
OVERWRITECLIURL=
TRUSTED_PROXIES=

# ---- PHP ------------------------------------------------------------------------------
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=512M
